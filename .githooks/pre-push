#!/usr/bin/env bash
set -euo pipefail

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
case "$current_branch" in
  main|master|prod|production|release/*)
    echo "pre-push: direct push from protected branch '$current_branch' is blocked" >&2
    exit 1
    ;;
esac

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/prod|refs/heads/production|refs/heads/release/*)
      echo "pre-push: push to protected remote branch '$remote_ref' is blocked" >&2
      exit 1
      ;;
  esac
done

exit 0
